# 복사해서 .env 로 쓰세요 (docker compose 가 자동으로 읽어요). .env 는 절대 Git 에 올리지 마세요.
ANTHROPIC_API_KEY=            # AI 코치·퀴즈·AI 시간표·AI 진단서용 (없으면 해당 기능만 꺼짐)
ADMIN_EMAIL=admin@example.com # 최초 관리자 계정
ADMIN_PASSWORD=               # 8자 이상, 첫 로그인 후 [계정]에서 바꾸세요
# CLAUDE_MODEL=claude-haiku-4-5-20251001   # 비용을 줄이고 싶을 때
# BACKUP_KEEP=14
BETA=1                       # 베타 테스트 중 표시(안내 배너, 검색엔진 색인 차단). 정식 오픈 때 지우세요
